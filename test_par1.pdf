<!--LOGINFORM-->
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
		<meta charset="utf-8" />
		<title>SPOT Kabupaten Tangerang</title>
		<link rel="icon" type="image/png" href="https://spot.tangerangkab.go.id/assets/img/kabtang.png" />
    
		<meta name="description" content="User login page" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />

		<link rel="stylesheet" href="https://spot.tangerangkab.go.id/assets/css/bootstrap.css" />
		<link rel="stylesheet" href="https://spot.tangerangkab.go.id/assets/css/font-awesome.css" />
		<link rel="stylesheet" href="https://spot.tangerangkab.go.id/assets/css/ace-fonts.css" />
		<link rel="stylesheet" href="https://spot.tangerangkab.go.id/assets/css/ace.css" />
		<link rel="stylesheet" href="https://spot.tangerangkab.go.id/assets/css/ace-rtl.css" />
		
		<script type="text/javascript">
			window.jQuery || document.write("<script src='https://spot.tangerangkab.go.id/assets/js/jquery.js'>"+"<"+"/script>");
		</script>
		<script type="text/javascript">
			if('ontouchstart' in document.documentElement) document.write("<script src='https://spot.tangerangkab.go.id/assets/js/jquery.mobile.custom.js'>"+"<"+"/script>");
		</script>
	</head>
	<body class="login-layout light-login">
		<div class="main-container">
			<div class="main-content">
				<div class="row">
					<div class="col-sm-10 col-sm-offset-1">
						<div class="login-container">
							<div class="center">
								<h1>
									<i class="ace-icon fa fa-calendar green"></i>
									<span class="red">SPOT</span>
									<span class="blue" id="id-text2">App</span>
								</h1>
								<h4 class="green" style="font-weight:bold;" id="id-company-text">Sistem Presensi Online Terpadu</h4>
								<h4 class="pink" style="font-weight:bold;" id="id-company-text">Pemerintah Kabupaten Tangerang</h4>
							</div>

							<div class="space-6"></div>

							<div class="position-relative">
								<div id="login-box" class="login-box visible widget-box no-border">
									<div class="widget-body">
										<div class="toolbar clearfix">
											<div>
												<a href="#" data-target="#forgot-box" class="forgot-password-link" style="font-weight:bold;">
													<i class="ace-icon fa fa-lock"></i>
													User Login
												</a>
											</div>

											<div>
												
											</div>
										</div>
										<div class="widget-main">
											<div class="space-6"></div>
																						<form action="https://spot.tangerangkab.go.id/main/validate" method="post" id="FormLogin">
												<fieldset>
													<label class="block clearfix">
														Username :
														<span class="block input-icon input-icon-right">
															<input type="text" class="form-control" placeholder="Username" name="username" id="username" value="">
															<i class="ace-icon fa fa-user"></i>
														</span>
													</label>

													<label class="block clearfix">
														Password
														<span class="block input-icon input-icon-right">
															<input type="password" class="form-control" placeholder="Password" name="password" id="password" value="">
															<i class="ace-icon fa fa-lock"></i>
														</span>
													</label>
													<label class="block clearfix">
														<div class="input-group">
															<span class="input-group-addon" style="padding:0;">
																<img src="https://spot.tangerangkab.go.id/capture/1785813363.0443.jpg" width="135" height="32" style="border:0;" alt=" " />															</span>
															<input type="text" class="form-control" placeholder="Masukan Kode" name="capture" id="capture">
															
														</div>
													</label>

													<div class="space"></div>

													<div class="clearfix">

														<button type="button" class="width-35 pull-right btn btn-sm btn-primary" onClick="Login();">
															<i class="ace-icon fa fa-key"></i>
															<span class="bigger-110" >Login</span>
														</button>
													</div>
													<div class="space-4"></div>
													
												</fieldset>
											</form>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script type="text/javascript">
			$(function(){
				$("#username").keypress(function(e){
					var key = null;
					key = (e.keyCode ? e.keyCode : e.which);
					if(key==13){
						Login()
					}
				});
				
				$("#password").keypress(function(e){
					var key = null;
					key = (e.keyCode ? e.keyCode : e.which);
					if(key==13){
						Login()
					}
				});
				
				$("#capture").keypress(function(e){
					var key = null;
					key = (e.keyCode ? e.keyCode : e.which);
					if(key==13){
						Login()
					}
				});
				
			});
			
			function Login()
			{
				$('#FormLogin').submit();
			}
		</script>
	</body>
</html>




