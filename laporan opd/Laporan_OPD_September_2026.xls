<table border="0" width=100% style="font-family: Tahoma; font-size: 9pt;">
    <tr>
        <td width="30" valign="top"><b>KETERANGAN :</b></td>
        <td width="5" valign="top"></td>
        <td width="295" valign="top"></td>
    </tr>
    <tr><td width="30" valign="top">MK</td><td width="5" valign="top"></td><td width="295" valign="top">Masuk Kerja</td></tr>
    <tr><td width="30" valign="top">TW</td><td width="5" valign="top"></td><td width="295" valign="top">Tepat Waktu</td></tr>
    <tr><td width="30" valign="top">PK</td><td width="5" valign="top"></td><td width="295" valign="top">Pulang Kerja</td></tr>
    <tr><td width="30" valign="top">(hr)</td><td width="5" valign="top"></td><td width="295" valign="top">Hari (diisi jumlah hari)</td></tr>
    <tr><td width="30" valign="top">(mnt/jam)</td><td width="5" valign="top"></td><td width="295" valign="top">Diisi jumlah menit (jika akumulasi dalam 1 bulan kurang dari 60 menit) dan jam (jika akumulasi dalam 1 bulan lebih dari 60 menit)</td></tr>
    <tr><td width="30" valign="top">TTWM-DI</td><td width="5" valign="top"></td><td width="295" valign="top">Tidak Tepat Waktu Masuk - Dengan Ijin</td></tr>
    <tr><td width="30" valign="top">TTWM-TI</td><td width="5" valign="top"></td><td width="295" valign="top">Tidak Tepat Waktu Masuk - Tanpa Ijin</td></tr>
    <tr><td width="30" valign="top">TTWP-DI</td><td width="5" valign="top"></td><td width="295" valign="top">Tidak Tepat Waktu Pulang - Dengan Ijin</td></tr>
    <tr><td width="30" valign="top">TTWP-TI</td><td width="5" valign="top"></td><td width="295" valign="top">Tidak Tepat Waktu Pulang - Tanpa Ijin</td></tr>
    <tr><td width="30" valign="top">AP</td><td width="5" valign="top"></td><td width="295" valign="top">Jumlah Mengikuti Apel Berdasarkan Jadwal (set_upacara)</td></tr>
    <tr><td width="30" valign="top">T-AP</td><td width="5" valign="top"></td><td width="295" valign="top">Jumlah Tidak Mengikuti Apel = Jadwal Apel - AP</td></tr>
    <tr><td width="30" valign="top">I</td><td width="5" valign="top"></td><td width="295" valign="top">Ijin</td></tr>
    <tr><td width="30" valign="top">S</td><td width="5" valign="top"></td><td width="295" valign="top">Sakit</td></tr>
