tps://spot.tangerangkab.go.id/laporan/rekapitulasi/harian\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t<i class=\"menu-icon icon-double-angle-right\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"menu-text\"> Harian </span>\r\n\t\t\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t\t\t<b class=\"arrow\"></b></li><li >\r\n\t\t\t\t\t\t\t\t\t\t\t<a class=\"\" href=\"https://spot.tangerangkab.go.id/laporan/rekapitulasi/bulanan\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t<i class=\"menu-icon icon-double-angle-right\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"menu-text\"> Bulanan </span>\r\n\t\t\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t\t\t<b class=\"arrow\"></b></li></ul></li><li >\r\n\t\t\t\t\t\t\t\t\t<a href=\"https://spot.tangerangkab.go.id/laporan/upacara\">\r\n\t\t\t\t\t\t\t\t\t\t<i class=\"menu-icon icon-double-angle-right\"></i>\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"menu-text\"> Laporan Upacara</span>\r\n\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t<b class=\"arrow\"></b></li></ul></li><li ><a href=\"\" class=\"dropdown-toggle\"><i class=\"menu-icon fa fa-cogs\"></i>\r\n\t\t\t\t\t\t\t\t <span class=\"menu-text\"> Utilitas </span>\r\n\t\t\t\t\t\t\t\t <b class=\"arrow fa fa-angle-down\"></b>\r\n\t\t\t\t\t\t\t\t </a><b class=\"arrow\"></b><ul class=\"submenu nav-show\"><li >\r\n\t\t\t\t\t\t\t\t\t<a href=\"https://spot.tangerangkab.go.id/utilitas/data_mesin\">\r\n\t\t\t\t\t\t\t\t\t\t<i class=\"menu-icon icon-double-angle-right\"></i>\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"menu-text\"> Mesin Absensi</span>\r\n\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t<b class=\"arrow\"></b></li><li >\r\n\t\t\t\t\t\t\t\t\t<a class=\"dropdown-toggle\" href=\"javascript:;\">\r\n\t\t\t\t\t\t\t\t\t\t<i class=\"menu-icon icon-double-angle-right\"></i>\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"menu-text\"> Setting Kehadiran </span>\r\n\t\t\t\t\t\t\t\t\t\t<b class=\"arrow fa fa-angle-down\"></b>\r\n\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t<b class=\"arrow\"></b><ul class=\"submenu nav-show\"><li >\r\n\t\t\t\t\t\t\t\t\t\t\t<a class=\"\" href=\"https://spot.tangerangkab.go.id/utilitas/kehadiran/shift\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t<i class=\"menu-icon icon-double-angle-right\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"menu-text\"> Jadwal Shift </span>\r\n\t\t\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t\t\t<b class=\"arrow\"></b></li></ul></li><li >\r\n\t\t\t\t\t\t\t\t\t<a href=\"https://spot.tangerangkab.go.id/utilitas/sinkronisasi\">\r\n\t\t\t\t\t\t\t\t\t\t<i class=\"menu-icon icon-double-angle-right\"></i>\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"menu-text\"> Sinkronisasi</span>\r\n\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t<b class=\"arrow\"></b></li></ul></li>\t\t\t\t</ul>\n\t\t\t\t<!-- #section:basics/sidebar.layout.minimize -->\n\t\t\t\t<div class=\"sidebar-toggle sidebar-collapse\" id=\"sidebar-collapse\">\n\t\t\t\t\t<i class=\"ace-icon fa fa-angle-double-left\" data-icon1=\"ace-icon fa fa-angle-double-left\" data-icon2=\"ace-icon fa fa-angle-double-right\"></i>\n\t\t\t\t</div>\n\n\t\t\t\t<!-- /section:basics/sidebar.layout.minimize -->\n\t\t\t\t<script type=\"text/javascript\">\n\t\t\t\t\ttry{ace.settings.check('sidebar' , 'collapsed')}catch(e){}\n\t\t\t\t</script>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"main-content\">\n\t\t\t\t<div class=\"main-content-inner\">\n\t\t\t\t\t<div class=\"page-content\">\n\t\t\t\t\t\t<div class=\"ace-settings-container\" id=\"ace-settings-container\" >\n\t\t\t\t\t\t\t<div class=\"btn btn-app btn-danger btn-xs\" id=\"ace-settings-btn\" style=\"margin-right: 20px; border-radius: 0; width: auto; padding: 5px 10px;\">\n\t\t\t\t\t\t\t\t<i class=\"ace-icon fa fa-calendar bigger-160\" style=\"float: left;\"></i> <span style=\"font-size: 14px; float: left; padding-left: 5px; line-height: 16px; text-align: left;\">15 April 2026 <br> <span style=\"font-size: 12px;\">Rabu, <span id=\"txt\"></span></span> </span>\n\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"page-header\">\n\t\t\t\t\t\t\t<h1>\n\t\t\t\t\t\t\t\tLaporan Kehadiran Harian\t\t\t\t\t\t\t</h1>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div class=\"col-xs-12\">\n\t\t\t\t\t\t\t\t<div id=\"display_data\">\r\n<div id=\"temp\">\r\n\r\n</div>\r\n<div class=\"row-fluid\" id=\"filter-data\" style=\"overflow:auto;\">\r\n\t<div class=\"box box-color box-bordered\">\n\t<div class=\"box-title\" style=\"margin-top:0;\">\n\t\t<h3><i class=\"fa fa-list-ul\"></i> Data Selection</h3>\n\t</div>\n\t<div class=\"box-content\" style=\"padding:5px;overflow:auto;\">\n\t\t<div class=\"row-fluid\">\n\t\t\t<div class=\"span6\">\n\t\t\t<div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">SKPD 1</div>\n\t\t\t\t\t<div class=\"span9\">\n\t\t\t\t\t\t<select name=\"kunkom_scr\" id=\"kunkom_scr\" class=\"input\" style=\"margin-bottom:2px;width:100%;\">\n\t\t\t\t\t\t\t<option value=\"11\">Dinas Kesehatan</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">SKPD 2</div>\n\t\t\t\t\t<div class=\"span9\">\n\t\t\t\t\t\t<select name=\"kununit_scr\" id=\"kununit_scr\" class=\"input\" style=\"margin-bottom:2px;width:100%;\">\n\t\t\t\t\t\t\t<option value=\"83\">UPTD Rumah Sakit Umum Daerah Tigaraksa</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">SKPD 3</div>\n\t\t\t\t\t<div class=\"span9\"><select name=\"unit1_scr\" id=\"unit1_scr\" class=\"input\" style=\"margin-bottom:2px;width:100%;\" onChange=\"getUnitKerja(this.value,3);\">\n<option value=\"\" selected=\"selected\">- Pilih SKPD 3 -</option>\n</select></div>\n\t\t\t\t</div><div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">SKPD 4</div>\n\t\t\t\t\t<div class=\"span9\"><select name=\"unit2_scr\" id=\"unit2_scr\" class=\"input\" style=\"margin-bottom:2px;width:100%;\" onChange=\"getUnitKerja(this.value,4);\">\n<option value=\"\" selected=\"selected\">- Pilih SKPD 4 -</option>\n</select></div>\n\t\t\t\t</div><div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">SKPD 5</div>\n\t\t\t\t\t<div class=\"span9\"><select name=\"unit3_scr\" id=\"unit3_scr\" onChange=\"getUnitKerja(this.value,5);\" class=\"input\" style=\"margin-bottom:2px;width:100%;\">\n<option value=\"\" selected=\"selected\">- Pilih SKPD 5 -</option>\n</select></div>\n\t\t\t\t</div><div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">SKPD 6</div>\n\t\t\t\t\t<div class=\"span9\"><select name=\"unit4_scr\" id=\"unit4_scr\" class=\"input\" style=\"margin-bottom:2px;width:100%;\">\n<option value=\"\" selected=\"selected\">- Pilih SKPD 6 -</option>\n</select></div>\n\t\t\t\t</div>\t\t\t</div>\n\t\t\t<div class=\"span6\">\n\t\t\t\t<div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">Status Pegawai</div>\n\t\t\t\t\t<div class=\"span9\">\n\t\t\t\t\t\t<select name=\"status_scr\" id=\"status_scr\" class=\"input\" style=\"margin-bottom:2px;\">\n<option value=\"1\" selected=\"selected\">Aktif</option>\n<option value=\"2\">Penisun</option>\n<option value=\"3\">Pindah Keluar</option>\n<option value=\"4\">Meninggal</option>\n</select>\t\t\t\t\t\t\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">Tanggal</div>\n\t\t\t\t\t<div class=\"span9\">\n\t\t\t\t\t\t<div class=\"input-append\">\n\t\t\t\t\t\t\t<input type=\"text\" class=\"input-small\" data-date-format=\"dd/mm/yyyy\" name=\"tgl_scr\" id=\"tgl_scr\" value=\"15/04/2026\" readonly data-rule-required=\"true\"/>\n\t\t\t\t\t\t\t<span class=\"add-on\" style=\"cursor:pointer;padding: 1px 4px\">\n\t\t\t\t\t\t\t\t<i class=\"fa fa-calendar\"></i>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"row-fluid\">\n\t\t\t\t\t<div class=\"span3\">NIP / Nama</div>\n\t\t\t\t\t<div class=\"span9\">\n\t\t\t\t\t\t<input name=\"nama_scr\" id=\"nama_scr\" type=\"text\" class=\"input\" style=\"margin-bottom:2px;width:100%;\" value=\"\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n<script>\n$(function(){\n\t$(\"#nama_scr\").keypress(function(e){\n\t\tvar key = null;\n        key = (e.keyCode ? e.keyCode : e.which);\n\t\tif(key==13){\n\t\t\tProses();\n\t\t}\n\t});\n\t\n\t$('#tgl_scr').datepicker({\n\t\tautoclose: true,\n\t\ttodayHighlight: true\n\t}).next().on('click', function(){\n\t\t$(this).prev().focus();\n\t});\n});\n\nfunction getUnitKerja(v,a)\n{\n\tif(v=='' || v=='00' || v == '000'){\n\t\tif(a==1){\n\t\t\t$('#kununit_scr').empty(); \n\t\t\t$('#unit1_scr').empty();\n\t\t\t$('#unit2_scr').empty();\n\t\t\t$('#unit3_scr').empty();$('#unit4_scr').empty();\n\t\t\t$('#kununit_scr').append('<option value=\"\">- Pilih SKPD 2 -</option>'); \n\t\t\t$('#unit1_scr').append('<option value=\"\">- Pilih SKPD 3 -</option>'); \n\t\t\t$('#unit2_scr').append('<option value=\"\">- Pilih SKPD 4 -</option>'); \n\t\t\t$('#unit3_scr').append('<option value=\"\">- Pilih SKPD 5 -</option>'); $('#unit4_scr').append('<option value=\"\">- Pilih SKPD 6 -</option>'); \n\t\t}\n\t\t\n\t\tif(a==2){\n\t\t\t$('#unit1_scr').empty();\n\t\t\t$('#unit2_scr').empty();\n\t\t\t$('#unit3_scr').empty();$('#unit4_scr').empty();\n\t\t\t$('#unit1_scr').append('<option value=\"\">- Pilih SKPD 3 -</option>'); \n\t\t\t$('#unit2_scr').append('<option value=\"\">- Pilih SKPD 4 -</option>'); \n\t\t\t$('#unit3_scr').append('<option value=\"\">- Pilih SKPD 5 -</option>'); $('#unit4_scr').append('<option value=\"\">- Pilih SKPD 6 -</option>'); \n\t\t}\n\t\t\n\t\tif(a==3){\n\t\t\t$('#unit2_scr').empty();\n\t\t\t$('#unit3_scr').empty();$('#unit4_scr').empty();\n\t\t\t$('#unit2_scr').append('<option value=\"\">- Pilih SKPD 4 -</option>'); \n\t\t\t$('#unit3_scr').append('<option value=\"\">- Pilih SKPD 5 -</option>'); $('#unit4_scr').append('<option value=\"\">- Pilih SKPD 6 -</option>');  \n\t\t}\n\t\t\n\t\tif(a==4){\n\t\t\t$('#unit3_scr').empty();$('#unit4_scr').empty(); \n\t\t\t$('#unit3_scr').append('<option value=\"\">- Pilih SKPD 5 -</option>'); $('#unit4_scr').append('<option value=\